# Vite inlines these at BUILD time.
#
# VITE_WHATSAPP_NUMBER is deliberately NOT set here. It used to hold a
# placeholder (+2349000000000), which Vite baked into every production bundle —
# that is why the live site showed a fake number in every WhatsApp link.
#
# The public number now comes from the server at runtime (SIREN_NG_MOBILE),
# injected into index.html as window.__SIREN_CONFIG__ and also served by
# GET /api/config/. Changing it is an env var + restart, never a rebuild.
#
# Empty = call the API on the same origin the page was served from.
VITE_API_BASE_URL=
